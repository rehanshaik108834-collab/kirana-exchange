# Copy to infra/.env.prod and replace every placeholder before deploying.
IMAGE_REGISTRY=ghcr.io/rehanshaik108834-collab/kirana-exchange
IMAGE_TAG=latest

POSTGRES_USER=kirana_admin
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

RABBITMQ_USER=kirana_admin
RABBITMQ_PASSWORD=CHANGE_ME_STRONG_AMQP_PASSWORD

JWT_SECRET=CHANGE_ME_64_CHAR_HEX_JWT_SECRET
INTERNAL_AUTH_SECRET=CHANGE_ME_64_CHAR_HEX_INTERNAL_HMAC_SECRET
REQUIRE_INTERNAL_AUTH=true
CORS_ORIGIN=https://kirana.example.com

SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM=alerts@kirana.exchange

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_STRONG_GRAFANA_PASSWORD
